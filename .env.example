# Copia este archivo como .env y ajusta los valores.

# Carpeta donde se guardan la base de datos, los EDF subidos y los resultados.
# Debe estar FUERA de la carpeta EEG-Platform (son datos de participantes).
# Si se deja vacía, se usa la carpeta EEG-Platform-datos al lado del repo.
EEG_PLATFORM_DATOS=C:\Users\migue\Desktop\TFG\EEG-Platform-datos

# Uso local: 1 muestra errores detallados en el navegador.
DJANGO_DEBUG=1

# Clave de Django. En uso local no protege nada expuesto a la red.
DJANGO_SECRET_KEY=solo-uso-local-cambiar-si-se-expone
