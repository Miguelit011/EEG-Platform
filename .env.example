# Configuración opcional. `instalar.bat` copia este archivo a `.env`; si no tocas nada,
# la plataforma funciona con los valores por defecto.

# Carpeta donde se guardan la base de datos, los EDF subidos y los resultados.
# Debe estar FUERA de la carpeta EEG-Platform (son datos de participantes menores de edad).
# Si se deja comentada, se usa la carpeta EEG-Platform-datos al lado de EEG-Platform.
# Ejemplo: EEG_PLATFORM_DATOS=D:\Datos\EEG-Platform-datos
# EEG_PLATFORM_DATOS=

# Procesos en paralelo del procesador. Si se deja vacío, se calcula en cada equipo:
# la mitad de los hilos, máximo 4, y un proceso por cada GB de memoria libre.
# En un portátil con batería, 1 o 2 lo hacen más lento pero más suave.
EEG_PLATFORM_PROCESOS=

# Uso local: 1 muestra errores detallados en el navegador.
DJANGO_DEBUG=1

# Clave de Django. En uso local no protege nada expuesto a la red.
DJANGO_SECRET_KEY=solo-uso-local-cambiar-si-se-expone
